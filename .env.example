# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# `docker compose` reads `.env` automatically. Never commit `.env`.
# ---------------------------------------------------------------------------

# ===== Google Ad Manager =====
GAM_NETWORK_CODE=9167326
GAM_API_VERSION=v202508

# Paste the FULL service-account JSON on a single line.
# Tip: produce it with `jq -c . gam-service-account.json` and wrap in quotes.
# The app materializes it to /app/gam-service-account.json at startup.
GAM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}

# ===== Gemini (AI assistant) =====
GAM_GEMINI_API_KEY=

# ===== Local Postgres (acts as Supabase replacement) =====
# These values are consumed by the postgres service and the app service.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=platform_annonceur

# The app service overrides these in docker-compose.yml so they point at the
# `postgres` container. Set them here only if you want to bypass the bundled DB
# (e.g. to talk to the real Supabase project).
# SUPABASE_DB_HOST=db.your-project.supabase.co
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_SSLMODE=require
